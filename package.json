{
  "name": "@interest-protocol/standards",
  "version": "0.1.0",
  "description": "Interest Protocol's house standard: Oxlint and oxfmt configs, tsconfig base and lint plugin.",
  "license": "MIT",
  "files": [
    "oxlint",
    "plugin",
    "oxfmt.json",
    "tsconfig.base.json",
    "STANDARD.md"
  ],
  "type": "module",
  "exports": {
    "./plugin": "./plugin/index.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxfmt.json": "./oxfmt.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "oxlint -c oxlint/base.json plugin scripts test/rules.test.mjs",
    "build:presets": "node scripts/build-presets.mjs",
    "check:presets": "node scripts/build-presets.mjs && git diff --exit-code oxlint/",
    "format": "oxfmt --check ."
  },
  "devDependencies": {
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-eslint": "1.94.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-eslint": "^1.94.0"
  },
  "engines": {
    "node": ">=24"
  }
}
