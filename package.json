{
  "name": "@interest-protocol/standards",
  "version": "0.4.0",
  "description": "Interest Protocol's house standard: Oxlint and oxfmt configs (base, React, Effect), tsconfig bases and lint plugin.",
  "license": "MIT",
  "bin": {
    "ip-standards-verify": "./bin/verify.mjs"
  },
  "files": [
    "bin",
    "oxlint",
    "plugin",
    "oxfmt.json",
    "tsconfig.base.json",
    "tsconfig.effect.json",
    "STANDARD.md"
  ],
  "type": "module",
  "exports": {
    "./plugin": "./plugin/index.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxfmt.json": "./oxfmt.json",
    "./package.json": "./package.json",
    "./tsconfig.effect.json": "./tsconfig.effect.json"
  },
  "scripts": {
    "test": "bun test test/*.test.mjs",
    "lint": "oxlint --deny-warnings plugin scripts bin test/rules.test.mjs test/verify.test.mjs test/effect.test.mjs",
    "build:presets": "bun scripts/build-presets.mjs",
    "check:presets": "bun scripts/build-presets.mjs && git diff --exit-code oxlint/",
    "format": "oxfmt --check ."
  },
  "devDependencies": {
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-eslint": "1.94.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-eslint": "^1.94.0"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4"
}
